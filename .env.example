# ===== Database =====
DATABASE_URL=postgresql://shughaily:shughaily@localhost:5432/shughaily
POSTGRES_USER=shughaily
POSTGRES_PASSWORD=shughaily
POSTGRES_DB=shughaily

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Express Backend =====
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-strong-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
FLASK_AI_URL=http://localhost:5001

# ===== Flask AI Service =====
FLASK_PORT=5001
HF_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EXPRESS_URL=http://localhost:4000

# ===== Storage (S3 / R2) =====
S3_BUCKET=shughaily-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=

# ===== Frontend =====
VITE_API_BASE_URL=/api/v1
VITE_DEV_SERVER_PORT=3000
VITE_BACKEND_URL=http://localhost:4000
