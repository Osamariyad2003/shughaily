# ===== Database =====
DATABASE_URL=postgresql://shughaily:shughaily@localhost:5432/shughaily
POSTGRES_USER=shughaily
POSTGRES_PASSWORD=shughaily
POSTGRES_DB=shughaily

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Express Backend =====
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-strong-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
FLASK_AI_URL=http://localhost:5001

# Shared secret proving a request to the AI service actually came from
# this backend — generate with e.g. `openssl rand -hex 32`. Must be the
# EXACT same value in both the backend's and ai-service's environment;
# both processes fail to start if it's unset.
INTERNAL_AUTH_TOKEN=change-me-generate-a-random-64-char-hex-secret

# ===== Flask AI Service =====
FLASK_PORT=5001
# Never "true" outside a machine nothing else can reach — the interactive
# Werkzeug debugger this enables is remote code execution.
FLASK_DEBUG=false
HF_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EXPRESS_URL=http://localhost:4000

# ===== Storage (S3 / R2) =====
S3_BUCKET=shughaily-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=

# ===== Frontend =====
VITE_API_BASE_URL=/api/v1
VITE_DEV_SERVER_PORT=3000
VITE_BACKEND_URL=http://localhost:4000
